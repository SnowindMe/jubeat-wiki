# 根仓库（伞状目录）忽略规则
#
# 根仓库只跟踪「跨代共用」的东西：AGENTS.md、docs/（域文档与 skill 配置），
# 以及三代站点各自的 gitlink。各代站点有自己的独立仓库与 .gitignore。
# 根仓库本身不装依赖、不构建。

# ---------------------------------------------------------------------------
# DSH 会话与记忆库
# ⚠️ .dsh-meow/ 是 meow-memory 插件的本地记忆库（SQLite）+ 会话日志，
#    含本机交互记录，属于本地状态，不进公网仓库。
# ---------------------------------------------------------------------------
.dsh-meow/
.dsh-meow/**/*.json

# ---------------------------------------------------------------------------
# 曲绘源 PNG
# ⚠️ songjackets/ 是**曲绘派生的源目录**（id<songId>.png，503 张，84 MB），
#    第三方受版权保护数据。v3 的 scripts/build-data.mjs 从它派生 public/jackets/
#    的 webp（命名规则 md5(源 PNG 字节)[0:10] + '.webp'）。
#    它只应在本地存在 —— 远程仓库不收录，本地删除会切断曲绘的「派生链自愈」能力。
# ---------------------------------------------------------------------------
songjackets/

# ---------------------------------------------------------------------------
# 通用临时产物（与各代站点的规则保持一致）
# ---------------------------------------------------------------------------
node_modules/
dist/
.astro/

# 构建日志
*.log

# 临时探针与草稿文件
*_probe*
*_probe_tmp*
*_tmp.*
.tmp-*
.tmp-*.mjs
.tmp-*.json

# 备份文件
*.bak
*.tmp

# 环境变量（铁律：密钥永远不进 Git）
.dev.vars
.env
.env.local

# 平台本地状态
.wrangler/
.vercel/
